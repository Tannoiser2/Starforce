{
  "starforce": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('host').val() === auth.uid && !newData.exists()",
        ".validate": "$code.length === 4",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "created": {
          ".write": "auth != null && !data.exists()"
        },
        "status": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "open": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid"
        },
        "game": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid"
        },
        "seats": {
          "$i": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || data.child('away').val() === true || root.child('starforce/rooms/' + $code + '/host').val() === auth.uid || newData.parent().parent().child('host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name']) && newData.child('name').isString() && newData.child('name').val().length <= 24"
          }
        },
        "acts": {
          "$n": {
            ".write": "auth != null && !data.exists() && newData.exists() && (root.child('starforce/rooms/' + $code + '/seats/' + newData.child('s').val() + '/uid').val() === auth.uid || root.child('starforce/rooms/' + $code + '/host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['s', 'k', 'v']) && newData.child('k').isString() && newData.child('k').val().length <= 8 && newData.child('v').isString() && newData.child('v').val().length <= 60000"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "saves": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid) && (!newData.exists() || newData.child('owner').val() === auth.uid)",
        ".validate": "$code.length === 5 && newData.hasChildren(['owner', 'cfg', 'acts']) && newData.child('acts').isString() && newData.child('acts').val().length <= 3000000"
      }
    }
  }
}
